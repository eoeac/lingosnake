/* 首页 — 学习闯关版 */
.page-container {
  min-height: 100vh;
  padding: 20rpx 0 48rpx;
  background:
    radial-gradient(circle at 12% 0%, rgba(191, 255, 34, 0.45), transparent 34%),
    linear-gradient(180deg, #f7ffe6 0%, #fbfff1 46%, #eefbdc 100%);
}

.hero-card {
  position: relative;
  overflow: hidden;
  margin: 0 20rpx 18rpx;
  padding: 34rpx 30rpx 30rpx;
  border-radius: 42rpx;
  background: linear-gradient(135deg, #bfff22 0%, #72e845 100%);
  color: #12321e;
  box-shadow: 0 24rpx 48rpx rgba(56, 125, 34, 0.22);
}

.hero-card::after {
  content: "";
  position: absolute;
  right: -46rpx;
  bottom: -58rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 58rpx;
  background: rgba(255, 255, 255, 0.36);
  transform: rotate(18deg);
}

.hero-top,
.hero-copy,
.hero-start,
.hero-stats,
.hero-action-band {
  position: relative;
  z-index: 1;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 34rpx;
}

.hero-brand {
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.2;
}

.hero-date {
  margin-top: 8rpx;
  color: rgba(18, 50, 30, 0.72);
  font-size: 23rpx;
  font-weight: 700;
}

.hero-settings {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  min-height: 0;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #12321e;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
  box-shadow: inset 0 -6rpx 0 rgba(18, 50, 30, 0.08);
}

.hero-title {
  max-width: 520rpx;
  font-size: 58rpx;
  font-weight: 950;
  line-height: 1.08;
  letter-spacing: 0;
}

.hero-subtitle {
  max-width: 560rpx;
  margin-top: 16rpx;
  color: rgba(18, 50, 30, 0.78);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.55;
}

.hero-start {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 108rpx;
  margin: 28rpx 0 0;
  border: none;
  border-radius: 30rpx;
  background: #12321e;
  color: #fff;
  font-size: 36rpx;
  font-weight: 900;
  box-shadow: 0 16rpx 0 rgba(18, 50, 30, 0.16);
}

.hero-start:active {
  transform: translateY(4rpx);
  box-shadow: 0 10rpx 0 rgba(18, 50, 30, 0.16);
}

.hero-start[disabled] {
  background: rgba(18, 50, 30, 0.42);
  color: rgba(255, 255, 255, 0.76);
  box-shadow: none;
}

.hero-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 28rpx;
}

.hero-stat {
  min-height: 118rpx;
  padding: 18rpx 12rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.62);
  box-shadow: inset 0 -5rpx 0 rgba(18, 50, 30, 0.06);
}

.hero-stat-value {
  font-size: 36rpx;
  font-weight: 950;
  line-height: 1;
}

.hero-stat-label {
  margin-top: 12rpx;
  color: rgba(18, 50, 30, 0.66);
  font-size: 22rpx;
  font-weight: 800;
}

.today-mission,
.material-focus,
.settings-drawer {
  border: 1rpx solid rgba(18, 50, 30, 0.08);
  box-shadow: 0 16rpx 34rpx rgba(67, 118, 31, 0.09);
}

.mission-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.mission-summary {
  margin: -8rpx 0 18rpx;
  color: rgba(93, 112, 90, 0.88);
  font-size: 23rpx;
  font-weight: 700;
}

.mission-grid .task-card {
  min-height: 126rpx;
  border-radius: 24rpx;
  background: #f5ffe1;
}

.mission-grid .task-card:nth-child(2) {
  background: #e9fff0;
}

.mission-grid .task-card:nth-child(3) {
  background: #fff8d7;
}

.mission-grid .task-card:nth-child(4) {
  background: #e7f8ff;
}

.mission-progress {
  overflow: hidden;
  height: 18rpx;
  margin-top: 22rpx;
  border-radius: 999rpx;
  background: #e5efd7;
}

.mission-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #16b84e, #bfff22);
}

.drawer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.drawer-arrow {
  flex: 0 0 auto;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #bfff22;
  color: #12321e;
  font-size: 24rpx;
  font-weight: 900;
}

.drawer-body {
  display: grid;
  gap: 2rpx;
  margin-top: 18rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid var(--border);
}

.material-picker-row .picker-view {
  max-width: 430rpx;
  text-align: right;
}

@media (max-width: 360px) {
  .hero-title {
    font-size: 50rpx;
  }
}

/* 设置抽屉窄屏重排，避免旧表单横向布局溢出 */
.settings-drawer .field {
  display: grid;
  grid-template-columns: 1fr;
  align-items: stretch;
  gap: 12rpx;
  padding: 18rpx 0;
}

.settings-drawer .field-label {
  white-space: normal;
}

.settings-drawer picker,
.settings-drawer .picker-view,
.settings-drawer .settings-input {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.settings-drawer .picker-view {
  min-height: 72rpx;
  border: 2rpx solid var(--border);
  border-radius: 18rpx;
  background: var(--surface);
  padding: 0 18rpx;
  text-align: left;
}

.settings-drawer .settings-input {
  min-height: 72rpx;
  text-align: left;
  padding: 0 18rpx;
}

.material-picker-row .picker-view {
  max-width: 100%;
  text-align: left;
}

.settings-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 18rpx;
}

.settings-drawer button {
  width: 100%;
  box-sizing: border-box;
  margin-left: 0;
  margin-right: 0;
}

.settings-actions .btn-primary,
.settings-actions .btn-danger {
  grid-column: 1 / -1;
}

/* 紧凑启动卡：减少首屏占高，避免海报感 */
.compact-start-card {
  padding: 24rpx 26rpx 22rpx;
  border-radius: 34rpx;
}

.compact-start-card::after {
  right: -34rpx;
  bottom: -56rpx;
  width: 170rpx;
  height: 170rpx;
  border-radius: 48rpx;
}

.compact-main {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 210rpx;
  align-items: center;
  gap: 18rpx;
}

.compact-copy {
  min-width: 0;
}

.compact-start-card .hero-brand {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 36rpx;
}

.compact-start-card .hero-date {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.compact-start {
  min-height: 84rpx;
  margin: 0;
  border-radius: 26rpx;
  font-size: 30rpx;
  box-shadow: 0 10rpx 0 rgba(18, 50, 30, 0.16);
}

.compact-stats {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 18rpx;
}

.compact-stats .hero-stat {
  min-height: 88rpx;
  padding: 14rpx 12rpx;
  border-radius: 22rpx;
}

.compact-stats .hero-stat-value {
  font-size: 30rpx;
}

.compact-stats .hero-stat-label {
  margin-top: 8rpx;
  font-size: 20rpx;
}

/* 启动按钮放到第二行，避免小屏右侧溢出 */
.compact-main {
  grid-template-columns: 1fr;
  gap: 18rpx;
}

.compact-start {
  width: 100%;
}

.hero-action-band {
  display: flex;
  justify-content: center;
  margin: 14rpx -26rpx -22rpx;
  padding: 22rpx 14rpx 24rpx;
  overflow: hidden;
}

.hero-action-band::after {
  content: "";
  position: absolute;
  right: -42rpx;
  bottom: -54rpx;
  width: 162rpx;
  height: 162rpx;
  border-radius: 54rpx;
  background: rgba(255, 255, 255, 0.28);
  transform: rotate(16deg);
}

/* 青柠玻璃统一版 */
.page-container {
  padding-top: 18rpx;
  background:
    radial-gradient(circle at 16% 0%, rgba(168, 255, 31, 0.34), transparent 34%),
    radial-gradient(circle at 88% 18%, rgba(20, 211, 111, 0.18), transparent 32%),
    linear-gradient(180deg, #F8FFED 0%, #F5FFE9 48%, #EEFCDF 100%);
}

.hero-card {
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  background:
    linear-gradient(135deg, rgba(184, 255, 38, 0.94) 0%, rgba(91, 235, 90, 0.9) 100%);
  box-shadow:
    0 24rpx 50rpx rgba(22, 143, 67, 0.2),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.72);
}

.compact-start-card {
  margin-top: 0;
  padding: 26rpx;
}

.compact-start-card::before {
  content: "";
  position: absolute;
  left: 26rpx;
  right: 26rpx;
  top: 0;
  height: 2rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
}

.compact-start-card::after {
  opacity: 0.7;
  border-radius: 60rpx;
}

.compact-start-card .hero-brand {
  font-size: 40rpx;
  letter-spacing: 0;
}

.compact-start-card .hero-date {
  color: rgba(14, 44, 27, 0.68);
}

.compact-start {
  min-height: 88rpx;
  width: 100%;
  max-width: 100%;
  margin: 0;
  border-radius: 28rpx;
  background:
    linear-gradient(180deg, rgba(18, 47, 29, 0.98), rgba(8, 33, 21, 0.98));
  box-shadow:
    0 12rpx 0 rgba(9, 71, 34, 0.24),
    0 22rpx 36rpx rgba(11, 77, 39, 0.24);
}

.hero-action-band .compact-start {
  position: relative;
  z-index: 1;
}

.hero-action-band > .hero-start.compact-start {
  display: flex;
  flex: 1 1 auto;
  width: 100%;
  min-width: 100%;
  max-width: none;
  box-sizing: border-box;
  margin-left: 0;
  margin-right: 0;
}

.compact-stats .hero-stat {
  background: rgba(255, 255, 255, 0.58);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.86),
    0 8rpx 18rpx rgba(14, 88, 42, 0.08);
}

.today-mission,
.material-focus,
.settings-drawer {
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(246, 255, 229, 0.76));
  border-color: rgba(255, 255, 255, 0.86);
}

.section-title {
  font-size: 33rpx;
}

.summary-text {
  color: rgba(93, 112, 90, 0.88);
}

.mission-grid .task-card {
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9),
    0 8rpx 18rpx rgba(30, 108, 50, 0.07);
}

.task-num {
  color: #13A94D;
}

.mission-progress {
  background: rgba(36, 83, 32, 0.1);
}

.mission-progress-fill {
  background: linear-gradient(90deg, #13A94D, #A8FF1F 58%, #F9FF8D);
  box-shadow: 0 0 18rpx rgba(168, 255, 31, 0.52);
}

.mat-card {
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  background: rgba(250, 255, 241, 0.72);
}

.mat-card.active {
  border-color: rgba(168, 255, 31, 0.9);
  background: rgba(250, 255, 238, 0.86);
  box-shadow:
    0 0 0 6rpx rgba(168, 255, 31, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.drawer-arrow {
  background: rgba(168, 255, 31, 0.82);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.72);
}

.settings-drawer .picker-view,
.settings-drawer .settings-input {
  border-color: rgba(33, 93, 36, 0.13);
  background: rgba(255, 255, 255, 0.72);
}

.settings-actions .btn-text {
  min-height: 76rpx;
  border-radius: 22rpx;
  background: rgba(245, 255, 225, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.82);
}
