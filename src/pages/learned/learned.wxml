<!-- 学习记录页 — 青柠玻璃风 -->
<view class="page-container">

  <view class="panel">
    <text style="font-size:26rpx;color:var(--muted);">{{summary}}</text>
  </view>

  <view wx:if="{{groups.length === 0}}" class="empty panel">暂无学习记录</view>

  <view wx:for="{{groups}}" wx:key="dateKey" class="panel">
    <view class="date-group-title">{{item.title}}</view>

    <view wx:if="{{item.hasNew}}">
      <view class="learned-section-title">新学词汇</view>
      <view class="word-list">
        <text
          wx:for="{{item.newWords}}" wx:key="id"
          class="word-tag {{it.isFormWord ? 'word-form-word' : ''}}"
          wx:for-item="it"
          data-id="{{it.id}}"
          bindtap="onWordTap"
        >{{it.word}}</text>
      </view>
    </view>

    <view wx:if="{{item.hasReview}}" style="margin-top: 12rpx;">
      <view class="learned-section-title">复习词汇</view>
      <view class="word-list">
        <text
          wx:for="{{item.reviewWords}}" wx:key="id"
          class="word-tag {{it.isFormWord ? 'word-form-word' : ''}}"
          wx:for-item="it"
          data-id="{{it.id}}"
          bindtap="onWordTap"
        >{{it.word}}</text>
      </view>
    </view>
  </view>

  <!-- 单词详情弹窗 -->
  <view wx:if="{{dialogVisible}}" class="dialog-mask" bindtap="closeDialog">
    <view class="dialog-content" catchtap="noop">
      <view class="dialog-title">{{dialogWord}}</view>
      <view wx:for="{{dialogContent}}" wx:key="label" class="dialog-item">
        <text class="dialog-label">{{item.label}}：</text>
        <text>{{item.value}}</text>
      </view>
      <button class="btn-primary" bindtap="closeDialog" style="margin-top:28rpx;">关闭</button>
    </view>
  </view>

</view>
